# Copy to .env (scripts/setup.sh generates one automatically with a random password).
POSTGRES_PASSWORD=change-me
TB_VERSION=4.3.1.6
TB_HTTP_PORT=8080
TB_MQTT_PORT=1883
# Public address. Local test: DOMAIN=localhost TLS_MODE=local. Cloud: real DNS name, TLS_MODE=acme, ACME_EMAIL set.
DOMAIN=localhost
TLS_MODE=local
ACME_EMAIL=
# Local-network device testing only: expose plain MQTT/HTTP ports to the LAN. Never on a cloud server.
# TB_BIND=0.0.0.0
